                  "const json = pm.response.json();",
                  "pm.test(\"Created book has an id and the sent values\", () => { pm.expect(json.data.id).to.be.a(\"number\"); pm.expect(json.data.title).to.eql(\"Postman Test Book\"); pm.expect(json.data.price).to.eql(499); });",
                  "pm.test(\"Location header points to the new book\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/books/\" + json.data.id));",
                  "pm.collectionVariables.set(\"bookId\", json.data.id);"
                ]
              }
            }
