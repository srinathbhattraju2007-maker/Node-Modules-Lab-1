          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Default limit 10 and offset 0\", () => { pm.expect(json.pagination.limit).to.eql(10); pm.expect(json.pagination.offset).to.eql(0); });",
                  "pm.test(\"data is an array of at most 10 books\", () => { pm.expect(json.data).to.be.an(\"array\"); pm.expect(json.data.length).to.be.at.most(10); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            },
            "description": ""
          }
        },
